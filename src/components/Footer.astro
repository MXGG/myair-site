---
import type { Lang } from '../data/site';
import { paths, site } from '../data/site';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const today = new Date();
const t = site[lang];
const p = paths[lang];
const isZh = lang === 'zh';
const githubRepo = 'https://github.com/MXGG/myair-site';
const releaseUrl = 'https://github.com/MXGG/myair-site/releases';
const email = 'lilx@hust.edu.cn';
---

<footer class="site-footer">
	<div class="footer-brand">
		<strong>{t.title}</strong>
		<p>{t.footer.summary}</p>
		<p class="footer-contact"><span>{isZh ? '地址：武汉市洪山区珞喻路 1037 号' : 'Address: 1037 Luoyu Road, Hongshan District, Wuhan, China'}</span><a href={`mailto:${email}`}>{email}</a></p>
	</div>
	<div class="footer-links" aria-label={t.footer.sections}>
		<span>{t.footer.sections}</span>
		<a href={p.home}>{t.nav.home}</a>
		<a href={p.pipeline}>{t.nav.pipeline}</a>
		<a href={p.data}>{t.nav.data}</a>
		<a href={p.methods}>{t.nav.methods}</a>
		<a href={p.blog}>{t.nav.blog}</a>
		<a href={p.downloads}>{t.nav.downloads}</a>
		<a href={p.about}>{t.nav.about}</a>
	</div>
	<div class="footer-links" aria-label={t.footer.resources}>
		<span>{t.footer.resources}</span>
		<a href={p.rss}>{t.footer.rss}</a>
		<a href={releaseUrl}>{t.footer.releases}</a>
		<a href={githubRepo}>{isZh ? '项目仓库' : 'Repository'}</a>
		<a href={`mailto:${email}`}>Email</a>
	</div>
	<p class="copyright">&copy; {today.getFullYear()} {t.footer.copyright}</p>
	<button class="back-to-top" type="button" data-back-to-top aria-label={isZh ? '返回顶部' : 'Back to top'}>↑</button>
</footer>

<script>
	const topButton = document.querySelector('[data-back-to-top]');
	const setTopButton = () => {
		if (!topButton) return;
		topButton.classList.toggle('visible', window.scrollY > 520);
	};
	window.addEventListener('scroll', setTopButton, { passive: true });
	setTopButton();
	topButton?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

	const revealSelectors = ['.hero-copy', '.hero-media', '.section-heading', '.pipeline-detail-card', '.panel', '.release-band', '.closing-note', '.page-hero', '.software-card', '.download-feature-card', '.featured-post', '.post-card', '.aside-card', '.article-header', '.article-prose', '.hero-image', '.topic-card', '.method-showcase-card', '.capability-column', '.release-table-card'];
	const targets = Array.from(document.querySelectorAll(revealSelectors.join(',')));
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
		document.body.classList.add('motion-ready');
		targets.forEach((item) => item.classList.add('reveal'));
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			});
		}, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
		targets.forEach((item) => observer.observe(item));
	}
</script>

<style>
	.site-footer {
		display: grid;
		width: min(var(--container-xl), calc(100% - 64px));
		margin: 0 auto;
		padding: 56px 0 72px;
		grid-template-columns: minmax(360px, 1.1fr) auto auto;
		gap: 54px;
		border-top: 1px solid var(--line-soft);
		color: var(--muted);
		font-size: 0.98rem;
	}
	.footer-brand { display: grid; gap: 12px; max-width: 760px; }
	.footer-brand > strong, .footer-links span { color: var(--ink); font-weight: 780; }
	.footer-contact { display: grid; gap: 4px; margin-top: 4px; line-height: 1.65; }
	.footer-contact a, .footer-links a { color: var(--muted); }
	.footer-contact a:hover, .footer-links a:hover { color: var(--accent-strong); }
	.footer-links { display: grid; gap: 8px; align-content: start; }
	.copyright { grid-column: 1 / -1; padding-top: 16px; border-top: 1px solid var(--line-soft); font-size: 0.88rem; }
	.back-to-top { position: fixed; right: 22px; bottom: 22px; z-index: 60; display: grid; width: 44px; height: 44px; place-items: center; border: 1px solid var(--line); border-radius: 999px; background: color-mix(in srgb, var(--surface) 88%, transparent); box-shadow: var(--shadow-soft); color: var(--accent-strong); font-size: 1.35rem; font-weight: 800; cursor: pointer; opacity: 0; pointer-events: none; transform: translateY(12px); transition: opacity 180ms ease, transform 180ms ease, background-color 180ms ease; }
	.back-to-top.visible { opacity: 1; pointer-events: auto; transform: translateY(0); }
	.back-to-top:hover { background: var(--blue-soft); transform: translateY(-2px); }
	@media (max-width: 900px) {
		.site-footer { width: min(var(--container), calc(100% - 32px)); grid-template-columns: 1fr; gap: 28px; }
	}
</style>
