---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { paths, site } from '../data/site';
const lang = 'en';
const t = site[lang];
const h = t.home;
const cards = [
  ['Level-2 GSM', 'Monthly Stokes coefficients from GRACE/GRACE-FO processing centers. Keep product center, release, degree/order, time tag, and missing-month status explicit.'],
  ['Gridded EWH', 'Equivalent water height anomaly grids generated after preprocessing, filtering, Love-number correction, and spherical harmonic synthesis.'],
  ['Mascon references', 'Independent gridded or basin-scale products for checking spatial patterns, seasonal amplitude, long-term trends, and leakage behavior.'],
  ['Auxiliary data', 'GIA models, SLR replacement coefficients, basin masks, land/ocean masks, hydrological models, and altimetry records used for validation.'],
];
const productMatrix = [
  ['Raw input', 'GSM coefficients', 'Product center, release, lmax, month flag'],
  ['Preprocessed anomaly', 'Corrected ΔC/ΔS', 'Degree-1/C20/C30 replacement, GIA model, baseline'],
  ['Filtered product', 'Tagged coefficient set or grid', 'Filter family, radius/order, HSAF parameters, product tag'],
  ['Application layer', 'EWH grid / basin series', 'Unit, grid resolution, mask version, leakage/scaling rule'],
];
const placeholders = [
  ['Data lineage diagram', 'Reserved for a diagram showing how raw GSM coefficients move through preprocessing, filtering, synthesis, and validation.'],
  ['Metadata checklist', 'Reserved for a downloadable checklist defining required product fields and naming conventions.'],
  ['Example dataset', 'Reserved for a small public test package after data redistribution permissions are confirmed.'],
];
---
<!doctype html>
<html lang={t.langCode}>
<head><BaseHead title={`Data Products | ${t.title}`} description={h.dataLead} lang={lang} alternateHref={paths.zh.data} /></head>
<body>
<Header lang={lang} alternateHref={paths.zh.data} />
<main class="page-shell topic-page">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href={paths.en.home}>Home</a><span>/</span><span>Data</span></nav>
  <section class="page-hero compact"><p class="eyebrow">Data</p><h1>Data Products</h1><p>{h.dataLead} This page defines the planned data-product vocabulary used by the website and the desktop workflow software.</p></section>
  <section class="topic-card-grid">{cards.map(([title,text]) => <article class="topic-card"><h2>{title}</h2><p>{text}</p></article>)}</section>
  <section class="release-table-card"><h2>Product lineage placeholder</h2><div class="responsive-table"><table><thead><tr><th>Layer</th><th>Product</th><th>Required metadata</th></tr></thead><tbody>{productMatrix.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody></table></div></section>
  <section class="placeholder-rail topic-placeholders">{placeholders.map(([title,text]) => <article class="placeholder-panel"><div class="placeholder-window" aria-hidden="true"><span></span><span></span><span></span></div><strong>{title}</strong><p>{text}</p></article>)}</section>
  <section class="note-callout"><strong>Quality principle</strong><p>Every product should keep its source, version, baseline, spatial grid, unit, and filter route explicit before any interpretation is made.</p></section>
</main>
<Footer lang={lang} />
</body>
</html>
