---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import GuestbookAdmin from '../../components/GuestbookAdmin.astro';
import Header from '../../components/Header.astro';
import { paths, site } from '../../data/site';

const lang = 'en';
const t = site[lang];
---

<!doctype html>
<html lang={t.langCode}>
	<head>
		<BaseHead title={`Guestbook records | ${t.title}`} description="Private guestbook administration." lang={lang} alternateHref="/zh/guestbook/admin/" />
		<meta name="robots" content="noindex, nofollow, noarchive" />
	</head>
	<body>
		<Header lang={lang} alternateHref="/zh/guestbook/admin/" />
		<main class="page-shell topic-page admin-page">
			<nav class="breadcrumb" aria-label="Breadcrumb"><a href={paths.en.home}>Home</a><span>/</span><a href={paths.en.guestbook}>Guestbook</a><span>/</span><span>Records</span></nav>
			<GuestbookAdmin lang={lang} />
		</main>
		<Footer lang={lang} />
	</body>
</html>

<style>.admin-page { min-height: 72vh; padding-bottom: 72px; }</style>
