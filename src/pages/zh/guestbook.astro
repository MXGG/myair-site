---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Guestbook from '../../components/Guestbook.astro';
import Header from '../../components/Header.astro';
import { paths, site } from '../../data/site';

const lang = 'zh';
const t = site[lang];
---

<!doctype html>
<html lang={t.langCode}>
	<head>
		<BaseHead
			title={`私密留言板 | ${t.title}`}
			description="无需注册账号，向 GRACE L2 Notes 维护者提交私密留言、项目问题或改进建议。"
			lang={lang}
			alternateHref={paths.en.guestbook}
		/>
	</head>
	<body>
		<Header lang={lang} alternateHref={paths.en.guestbook} />
		<main class="page-shell topic-page guestbook-page">
			<nav class="breadcrumb" aria-label="面包屑导航"><a href={paths.zh.home}>首页</a><span>/</span><span>留言板</span></nav>
			<section class="page-hero compact">
				<p class="eyebrow">私密留言</p>
				<h1>留言板</h1>
				<p>您可以就 GRACE Level-2 数据处理、软件使用或网站内容留下问题与建议。提交记录仅站点所有者可见。</p>
			</section>
			<Guestbook lang={lang} />
		</main>
		<Footer lang={lang} />
	</body>
</html>

<style>
	.guestbook-page { padding-bottom: 72px; }
	.page-hero { margin-inline: auto; text-align: center; }
</style>
