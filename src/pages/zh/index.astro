---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { getBlogPath, paths, site } from '../../data/site';
import DashboardImage from '../../assets/grace/dashboard.png';
import GravityHeroImage from '../../assets/grace/gravity-hero.png';
import PreviewImage from '../../assets/grace/preview.png';

const lang = 'zh';
const t = site[lang];
const h = t.home;
const posts = (await getCollection('blogZh'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const formulaTex = [
	String.raw`S(\theta,\lambda,t)=\{\Delta C_{lm}(t),\Delta S_{lm}(t)\},\quad 0\le m\le l\le l_{\max}`,
	String.raw`\Delta C'_{lm}=\Delta C_{lm}-\Delta C_{lm,\mathrm{mean}}-\Delta C_{lm,\mathrm{GIA}}`,
	String.raw`\hat{x}=F\{x\},\quad F\in\{\mathrm{Gaussian}(r),\mathrm{Fan}(r),\mathrm{PnMm},\mathrm{DDK}_k,\mathrm{HSAF}\}`,
	String.raw`\mathrm{EWH}(\theta,\lambda)=\frac{a\rho_e}{3\rho_w}\sum_{l=0}^{l_{\max}}\sum_{m=0}^{l}\frac{2l+1}{1+k_l}\bar{P}_{lm}(\cos\theta)\left(\Delta C_{lm}\cos m\lambda+\Delta S_{lm}\sin m\lambda\right)`,
	String.raw`\mathrm{TWSA}_{\mathrm{basin}}(t)=\frac{\sum_i A_i\,\mathrm{EWH}_i(t)}{\sum_i A_i}`,
];
const stepIcons = [
	'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 27l13-6 6 6-6 13-4-9-9-4Z"/><path d="M27 9l12 12M32 4l12 12M18 18l12 12"/><path d="M31 21 21 31"/></svg>',
	'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M12 13h24M12 24h24M12 35h24"/><circle cx="19" cy="13" r="4"/><circle cx="30" cy="24" r="4"/><circle cx="22" cy="35" r="4"/></svg>',
	'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 16c8 0 8 16 16 16s8-16 16-16"/><path d="M10 34h28"/><path d="M32 10h8v8"/><path d="M40 10 29 21"/></svg>',
	'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 12h28v24H10z"/><path d="M10 20h28M10 28h28M19 12v24M29 12v24"/><path d="M6 40h36"/></svg>',
	'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M14 25l7 7 14-17"/><path d="M24 7a17 17 0 1 0 0 34 17 17 0 0 0 0-34Z"/></svg>',
];

const capabilityCards = [
	['数据导入管理', '占位说明：批量导入 Level-2 GSM 球谐产品，并保留处理中心、版本、月份、最高阶次和低阶项替换元数据。'],
	['滤波路线对比', '占位说明：并行生成 Gaussian、去相关、DDK 与 HSAF 产品，并通过明确标签管理各类诊断结果。'],
	['产品快速预览', '占位说明：在导出前检查全球格网图、流域平均、异常时间序列和残余条带结构。'],
	['流域尺度分析', '占位说明：计算面积加权 TWSA、年/半年振幅、线性趋势、泄漏校正序列和对比表格。'],
	['可复现输出', '占位说明：输出配置快照、图像预览、处理日志和便于版本归档的结果目录。'],
	['质量控制记录', '占位说明：汇总图像检查、谱域检查、单位检查、参考产品对比和缺失月份审计结果。'],
];

const interfacePlaceholders = [
	['工作流仪表盘', '预留软件工作区截图位置，可展示数据集选择、滤波路线配置和导出状态。'],
	['格网预览面板', '预留图像或短动画位置，可展示 EWH 格网预览、色标控制和产品对比。'],
	['流域诊断报告', '预留时间序列图、年振幅图、趋势统计和泄漏校正报告展示位置。'],
];
---

<!doctype html>
<html lang={t.langCode}>
	<head>
		<BaseHead title={t.title} description={t.description} image={GravityHeroImage} lang={lang} alternateHref={paths.en.home} />
	</head>
	<body>
		<Header lang={lang} alternateHref={paths.en.home} />
		<main class="home-shell">
			<section class="hero" aria-labelledby="hero-title">
				<div class="geo-labels" aria-hidden="true">
					<span class="lat lat-60">60°N</span>
					<span class="lat lat-30">30°N</span>
					<span class="lat lat-0">0°</span>
					<span class="lat lat-s30">30°S</span>
					<span class="lat lat-s60">60°S</span>
					<span class="lon lon-180">180°</span>
					<span class="lon lon-120">120°W</span>
					<span class="lon lon-60">60°W</span>
					<span class="lon lon-0">0°</span>
					<span class="lon lon-60e">60°E</span>
					<span class="lon lon-120e">120°E</span>
					<span class="lon lon-180e">180°</span>
				</div>
				<div class="hero-copy">
					<p class="eyebrow">{h.eyebrow}</p>
					<h1 id="hero-title"><span>GRACE Level‑2</span><span>数据处理流程</span></h1>
					<p class="subtitle">{h.subtitle}</p>
					<p class="hero-text">{h.text}</p>
					<div class="hero-actions">
						<a class="button primary" href="#pipeline">{h.primaryAction}</a>
						<a class="button ghost" href={paths.zh.blog}>{h.secondaryAction}</a>
					</div>
				</div>
				<div class="hero-media" aria-hidden="true">
					<Image src={GravityHeroImage} width={1662} height={974} quality={92} alt="" loading="eager" />
				</div>
			</section>


			<section class="learning-center" aria-labelledby="learning-title">
				<div class="section-heading wide-heading">
					<p class="section-label">00</p>
					<h2 id="learning-title">学习中心</h2>
					<p>从主题出发，快速进入处理流程、方法记录、数据产品和软件发布说明。</p>
				</div>
				<div class="learning-grid">
					<a class="learning-card" href={paths.zh.pipeline}><span>流程</span><strong>处理链路</strong><p>获取、预处理、滤波、合成与验证 GRACE Level-2 产品。</p></a>
					<a class="learning-card" href={paths.zh.methods}><span>方法</span><strong>滤波记录</strong><p>对比 Gaussian、去相关、DDK、HSAF 和泄漏校正路线。</p></a>
					<a class="learning-card" href={paths.zh.data}><span>数据</span><strong>产品与参考</strong><p>追踪 GSM 系数、EWH 格网、Mascon、掩膜与诊断信息。</p></a>
					<a class="learning-card" href={paths.zh.blog}><span>文章</span><strong>可复现记录</strong><p>阅读处理假设、质量检查和产品约定的双语笔记。</p></a>
				</div>
			</section>

			<section class="capability-showcase" aria-labelledby="capability-title">
				<div class="section-heading wide-heading">
					<p class="section-label">01</p>
					<h2 id="capability-title">软件功能概览</h2>
					<p>这里先放置 GRACE Level-2 桌面工作流软件的功能介绍占位文案，后续可替换为真实界面截图、版本功能说明和发布记录。</p>
				</div>
				<div class="capability-grid">
					{capabilityCards.map(([title, text], index) => (
						<article class="capability-card">
							<span>{String(index + 1).padStart(2, '0')}</span>
							<h3>{title}</h3>
							<p>{text}</p>
						</article>
					))}
				</div>
				<div class="placeholder-rail" aria-label="软件界面占位区">
					{interfacePlaceholders.map(([title, text]) => (
						<article class="placeholder-panel">
							<div class="placeholder-window" aria-hidden="true"><span></span><span></span><span></span></div>
							<strong>{title}</strong>
							<p>{text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="section-block pipeline-section" id="pipeline" aria-labelledby="pipeline-title">
				<div class="section-heading wide-heading">
					<p class="section-label">02</p>
					<h2 id="pipeline-title">{h.pipelineTitle}</h2>
					<p>{h.pipelineDetailIntro}</p>
				</div>
				<div class="pipeline-detail-grid">
					{h.pipelineSteps.map(([title, body], index) => {
						const detail = h.pipelineDetails[index];
						return (
							<details class="pipeline-detail-card" id={`step-${index + 1}`}>
								<summary>
									<span class="step-icon" set:html={stepIcons[index]}></span>
									<span class="summary-copy">
										<span>{String(index + 1).padStart(2, '0')}</span>
										<strong>{title}</strong>
										<small>{body}</small>
									</span>
									<span class="expand-mark">+</span>
								</summary>
								<div class="step-detail prose-card">
									<h3>原理</h3>
									<p>{detail.principle}</p>
									<h3>公式</h3>
									<div class="formula-block">{`\\[${formulaTex[index]}\\]`}</div>
									<h3>配置示例</h3>
									<dl class="config-list">
										{detail.config.map(([key, value]) => (
											<>
												<dt>{key}</dt>
												<dd>{value}</dd>
											</>
										))}
									</dl>
									<h3>质量检查</h3>
									<ul>{detail.checks.map((item) => <li>{item}</li>)}</ul>
								</div>
							</details>
						);
					})}
				</div>
			</section>

			<section class="section-grid" aria-label="GRACE Level-2 网站栏目">
				<div class="panel feature-panel" id="data">
					<div class="panel-title">
						<p class="section-label">03</p>
						<h2>{h.dataTitle}</h2>
						<p>{h.dataLead}</p>
					</div>
					<div class="feature-list">
						{h.dataCards.map((card, index) => (
							<article class="media-card">
								<Image src={index === 0 ? PreviewImage : DashboardImage} width={148} height={148} alt="" />
								<div>
									<h3>{card.title}</h3>
									<p>{card.text}</p>
									<a href={card.href}>{card.linkText}</a>
								</div>
							</article>
						))}
					</div>
				</div>

				<div class="panel method-panel" id="methods">
					<div class="panel-title">
						<p class="section-label">04</p>
						<h2>{h.methodTitle}</h2>
						<p>{h.methodLead}</p>
					</div>
					<div class="method-list">
						{h.methodCards.map((card, index) => (
							<article class="method-card">
								<div class:list={['mini-plot', index === 0 ? 'line-plot' : 'gaussian-plot']} aria-hidden="true"></div>
								<div>
									<h3>{card.title}</h3>
									<p>{card.text}</p>
									<a href="/zh/blog/second-post/">{t.blog.read}</a>
								</div>
							</article>
						))}
					</div>
				</div>

				<div class="panel posts-panel">
					<div class="panel-title">
						<p class="section-label">05</p>
						<h2>{h.recentTitle}</h2>
						<p>{h.recentLead}</p>
					</div>
					<div class="compact-post-list">
						{posts.map((post) => (
							<a href={getBlogPath(lang, post.id)}>
								<span><FormattedDate date={post.data.pubDate} /></span>
								<strong>{post.data.title}</strong>
							</a>
						))}
					</div>
					<a class="all-link" href={paths.zh.blog}>{h.allArticles}</a>
				</div>
			</section>

			<section class="release-band" aria-labelledby="release-title">
				<div>
					<h2 id="release-title">{h.releaseTitle}</h2>
					<p>{h.releaseText}</p>
				</div>
				<a class="button primary" href={paths.zh.downloads}>{h.releaseAction}</a>
			</section>

			<section class="closing-note">
				<blockquote>
					{h.quote}<br />
					<span>{h.quoteSub}</span>
				</blockquote>
			</section>
		</main>
		<Footer lang={lang} />
		<script is:inline data-pipeline-accordion>
			document.querySelectorAll('.pipeline-detail-card').forEach((card) => {
				card.addEventListener('toggle', () => {
					if (!card.open) return;
					document.querySelectorAll('.pipeline-detail-card[open]').forEach((other) => {
						if (other !== card) other.removeAttribute('open');
					});
					if (window.MathJax?.typesetPromise) window.MathJax.typesetPromise([card]).catch(() => {});
				});
			});
		</script>

	</body>
</html>
