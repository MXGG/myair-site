---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { paths, site } from '../../data/site';
const lang = 'zh';
const t = site[lang];
const h = t.home;
const cards = [
  ['Level-2 GSM', 'GRACE/GRACE-FO 处理中心发布的月尺度 Stokes 球谐系数产品，需要明确处理中心、版本、阶次、月份标识和缺失月份状态。'],
  ['格网 EWH', '在预处理、滤波、勒夫数改正和球谐合成之后生成的等效水高异常格网产品。'],
  ['Mascon 参考', '用于检查空间形态、季节振幅、长期趋势和泄漏误差表现的独立格网或流域尺度产品。'],
  ['辅助数据', '包括 GIA 模型、SLR 替换项、流域掩膜、海陆掩膜、水文模型和卫星测高资料等验证数据。'],
];
const productMatrix = [
  ['原始输入', 'GSM 球谐系数', '处理中心、版本、lmax、月份标识'],
  ['预处理异常', '改正后的 ΔC/ΔS', '一阶项/C20/C30 替换、GIA 模型、基准期'],
  ['滤波产品', '带标签的系数集或格网', '滤波方法、半径/阶数、HSAF 参数、产品标签'],
  ['应用层产品', 'EWH 格网 / 流域序列', '单位、格网分辨率、掩膜版本、泄漏/尺度因子规则'],
];
const placeholders = [
  ['数据谱系图', '预留示意图位置，用于展示 GSM 系数如何经过预处理、滤波、合成和验证。'],
  ['元数据检查表', '预留下载型检查表位置，用于定义必须保留的产品字段和命名规则。'],
  ['示例数据集', '在确认数据再分发权限之后，可预留一个小型公开测试包。'],
];
---
<!doctype html>
<html lang={t.langCode}>
<head><BaseHead title={`数据产品 | ${t.title}`} description={h.dataLead} lang={lang} alternateHref={paths.en.data} /></head>
<body>
<Header lang={lang} alternateHref={paths.en.data} />
<main class="page-shell topic-page">
  <nav class="breadcrumb" aria-label="面包屑导航"><a href={paths.zh.home}>首页</a><span>/</span><span>数据</span></nav>
  <section class="page-hero compact"><p class="eyebrow">Data</p><h1>数据产品</h1><p>{h.dataLead} 本页面用于定义网站与桌面工作流软件共用的数据产品词汇和占位说明。</p></section>
  <section class="topic-card-grid">{cards.map(([title,text]) => <article class="topic-card"><h2>{title}</h2><p>{text}</p></article>)}</section>
  <section class="release-table-card"><h2>产品谱系占位表</h2><div class="responsive-table"><table><thead><tr><th>层级</th><th>产品</th><th>必要元数据</th></tr></thead><tbody>{productMatrix.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody></table></div></section>
  <section class="placeholder-rail topic-placeholders">{placeholders.map(([title,text]) => <article class="placeholder-panel"><div class="placeholder-window" aria-hidden="true"><span></span><span></span><span></span></div><strong>{title}</strong><p>{text}</p></article>)}</section>
  <section class="note-callout"><strong>质量原则</strong><p>任何产品在解释之前，都应明确来源、版本、基准期、空间格网、单位和滤波路线。</p></section>
</main>
<Footer lang={lang} />
</body>
</html>
